<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CustomerRegistrationController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="REGISTER NEW CUSTOMER" />
   <Label text="Full Name:" />
   <TextField fx:id="nameField" promptText="Enter customer's full name" />
   <Label text="Email Address:" />
   <TextField fx:id="emailField" promptText="Enter customer's email" />
   <Label text="Set Password:" />
   <TextField fx:id="passField" promptText="Set customer's password" />
   <Button fx:id="registerBtn" onAction="#handleRegister" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 35;" text="Register Customer" />
   <Button fx:id="backBtn" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 140; -fx-pref-height: 35;" text="Back to Dashboard" />
   <Label fx:id="messageLabel" />
</VBox>