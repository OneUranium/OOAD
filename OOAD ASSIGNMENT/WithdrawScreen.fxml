<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="WithdrawController">
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
   <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="MAKE WITHDRAWAL" />
   <Label text="Amount:" />
   <TextField fx:id="amountField" promptText="Enter withdrawal amount" />
   <Button fx:id="withdrawBtn" onAction="#handleWithdraw" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-pref-width: 180; -fx-pref-height: 35;" text="PROCESS WITHDRAWAL" />
   <Button fx:id="backBtn" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 140; -fx-pref-height: 35;" text="Back to Dashboard" />
   <Label fx:id="messageLabel" />
</VBox>