<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CustomerLoginController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="CUSTOMER LOGIN" />
   <Label text="Email Address:" />
   <TextField fx:id="emailField" promptText="Enter your email" />
   <Label text="Password:" />
   <PasswordField fx:id="passField" promptText="Enter your password" />
   <Button fx:id="loginBtn" onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-pref-width: 120; -fx-pref-height: 35;" text="LOGIN" />
   <Button fx:id="backBtn" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 80; -fx-pref-height: 35;" text="Back" />
   <Label fx:id="messageLabel" />
</VBox>