<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CustomerDashboardController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   <Label fx:id="infoLabel" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="CUSTOMER DASHBOARD" />
   <Label fx:id="balanceLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="Total Balance: P0.00" />
   <Label style="-fx-font-size: 14px;" text="Select Account:" />
   <ComboBox fx:id="accountComboBox" promptText="Choose an account" prefWidth="200" />
   <Label style="-fx-font-size: 14px;" text="Your Accounts:" />
   <TextArea fx:id="accountsArea" prefWidth="300.0" prefHeight="100.0" editable="false" style="-fx-font-weight: bold;" />
   <Button fx:id="depositBtn" onAction="#handleDeposit" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-pref-width: 150; -fx-pref-height: 35;" text="Make Deposit" />
   <Button fx:id="withdrawBtn" onAction="#handleWithdraw" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-pref-width: 150; -fx-pref-height: 35;" text="Make Withdrawal" />
   <Button fx:id="historyBtn" onAction="#handleHistory" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-pref-width: 150; -fx-pref-height: 35;" text="Transaction History" />
   <Button fx:id="logoutBtn" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-pref-width: 100; -fx-pref-height: 35;" text="Logout" />
</VBox>