<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="RoleSelectionController">
   <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
   <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="BANKING SYSTEM" />
   <Label style="-fx-font-size: 16px;" text="Select Your Role" />
   <Button fx:id="bankTellerBtn" onAction="#handleBankTellerLogin" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 200; -fx-pref-height: 40;" text="Bank Teller Login" />
   <Button fx:id="customerBtn" onAction="#handleCustomerLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-pref-width: 200; -fx-pref-height: 40;" text="Customer Login" />
</VBox>