<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="BankTellerDashboardController">
   <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
   <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="BANK TELLER DASHBOARD" />
   <Label fx:id="infoLabel" style="-fx-font-size: 14px;" text="Teller: #TEL001 - System Administrator" />
   <Button fx:id="registerCustomerBtn" onAction="#handleRegisterCustomer" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-pref-width: 220; -fx-pref-height: 40;" text="Register New Customer" />
   <Button fx:id="viewCustomersBtn" onAction="#handleViewCustomers" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-pref-width: 220; -fx-pref-height: 40;" text="View All Customer Accounts" />
   <Button fx:id="logoutBtn" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-pref-width: 120; -fx-pref-height: 35;" text="Logout" />
</VBox>