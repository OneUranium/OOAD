<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="TransactionHistoryController">
   <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
   <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="TRANSACTION HISTORY" />
   <TextArea fx:id="historyArea" prefWidth="600.0" prefHeight="400.0" editable="false" style="-fx-font-family: 'Courier New'; -fx-font-size: 12px;" />
   <Button fx:id="backBtn" onAction="#handleBack" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-pref-width: 160; -fx-pref-height: 35;" text="Back to Dashboard" />
</VBox>